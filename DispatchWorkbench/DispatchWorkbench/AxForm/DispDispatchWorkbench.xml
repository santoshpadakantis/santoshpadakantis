						<Type>Button</Type>
						<Methods>
							<Method>
								<Name>clicked</Name>
								<Source><![CDATA[
public void clicked()
{
    super();
    if (!element.originLocation)
    {
        warning("@DispatchWB:SelectOrigin");
        return;
    }
    DispRouteOptimizer opt = new DispRouteOptimizer(element.fromDate, element.originLocation);
    DispDispatchId dispatchId = opt.createDispatch(DispPendingOrderTmp);
    info(strFmt("@DispatchWB:DispatchCreated", dispatchId));
    element.refreshPending();
    element.refreshSchedule();
}
]]></Source>
