	<Name>DispDispatchWorkbench</Name>
	<SourceCode>
		<Methods>
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class DispDispatchWorkbench extends FormRun
{
    TransDate  fromDate;
    TransDate  toDate;
    InventLocationId originLocation;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
public void init()
{
    super();
    fromDate = today();
    toDate   = today() + 2; // default 1-3 day horizon
    DateFrom.dateValue(fromDate);
    DateTo.dateValue(toDate);
    element.refreshPending();
    element.refreshSchedule();
}
]]></Source>
			</Method>
			<Method>
				<Name>refreshPending</Name>
				<Source><![CDATA[
public void refreshPending()
{
    DispRouteOptimizer::loadPendingOrders(DispPendingOrderTmp, fromDate, toDate);
    PendingGrid_ds.research();
}
]]></Source>
			</Method>
			<Method>
				<Name>refreshSchedule</Name>
				<Source><![CDATA[
public void refreshSchedule()
{
    DispDispatchHeader_ds.query().dataSourceTable(tableNum(DispDispatchHeader))
        .clearRanges();
    QueryBuildRange r = DispDispatchHeader_ds.query()
        .dataSourceTable(tableNum(DispDispatchHeader))
        .addRange(fieldNum(DispDispatchHeader, DispatchDate));
    r.value(strFmt('%1..%2', fromDate, toDate));
    DispDispatchHeader_ds.executeQuery();
}
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
