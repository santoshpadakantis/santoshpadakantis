						<Methods>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
public boolean modified()
{
    boolean ret = super();
    element.fromDate = this.dateValue();
    if (element.toDate < element.fromDate)
    {
        element.toDate = element.fromDate + 2;
        DateTo.dateValue(element.toDate);
    }
    if ((element.toDate - element.fromDate) > 2)
    {
        element.toDate = element.fromDate + 2;
        DateTo.dateValue(element.toDate);
        warning("@DispatchWB:WindowLimited");
    }
    element.refreshPending();
    element.refreshSchedule();
    return ret;
}
]]></Source>
							</Method>
						</Methods>
					</AxFormControl>
