				<Source><![CDATA[
public static DispDispatchHeader find(DispDispatchId _dispatchId, boolean _forUpdate = false)
{
    DispDispatchHeader header;
    header.selectForUpdate(_forUpdate);
    select firstonly header
        where header.DispatchId == _dispatchId;
    return header;
}
]]></Source>
