				<Source><![CDATA[
public static DispDriverTable find(DispDriverId _driverId, boolean _forUpdate = false)
{
    DispDriverTable driver;
    driver.selectForUpdate(_forUpdate);
    select firstonly driver
        where driver.DriverId == _driverId;
    return driver;
}
]]></Source>
