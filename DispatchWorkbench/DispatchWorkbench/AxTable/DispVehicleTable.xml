				<Source><![CDATA[
public static DispVehicleTable find(DispVehicleId _vehicleId, boolean _forUpdate = false)
{
    DispVehicleTable vehicle;
    vehicle.selectForUpdate(_forUpdate);
    select firstonly vehicle
        where vehicle.VehicleId == _vehicleId;
    return vehicle;
}
]]></Source>
